{
  "name": "atlyn-cohort-retention",
  "version": "1.0.0",
  "description": "Atlyn Cohort Retention Power BI custom visual",
  "private": true,
  "scripts": {
    "build": "webpack --mode production",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "eslint": "npx eslint . --ext .js,.jsx,.ts,.tsx",
    "lint": "npm run eslint",
    "package": "node scripts/package.js && npm run certification:audit",
    "certification:audit": "node scripts/certification-audit.js",
    "audit": "npm audit"
  },
  "dependencies": {
    "powerbi-visuals-api": "5.11.1"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "22.15.21",
    "@typescript-eslint/eslint-plugin": "8.32.1",
    "@typescript-eslint/parser": "8.32.1",
    "eslint": "8.57.1",
    "eslint-plugin-powerbi-visuals": "1.1.1",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "ts-jest": "29.3.2",
    "ts-loader": "9.5.2",
    "typescript": "5.8.3",
    "webpack": "5.109.2",
    "webpack-cli": "6.0.1"
  },
  "engines": {
    "node": ">=18"
  }
}
